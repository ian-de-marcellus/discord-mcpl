DISCORD_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=optional-guild-id-filter

# Inline cap for text attachments on live delivery, in bytes (default 5120).
# A text attachment over this many actual bytes is not rendered into the
# agent's context; it degrades to a name+size+URL note instead. 0 disables
# text auto-inlining entirely; values above 262144 (256KiB) clamp to that
# absolute ceiling; malformed or negative values log an error and fall back
# to the default. Raising the cap intentionally restores the old
# always-inline behavior. Images are unaffected — they inline as native
# image blocks under their own ceilings.
#DISCORD_ATTACHMENT_INLINE_MAX_BYTES=5120

# Optional, per-process voice-message augmentation. Transcription remains
# configured separately; when enabled, the bridge analyzes the locally cached
# source audio with ffmpeg and adds a log-frequency spectrogram plus descriptive
# signal measurements to the same incoming message. Derived PNG/JSON artifacts
# are cached by immutable Discord attachment id. Leave this unset for residents
# that should receive transcript-only delivery.
#DISCORD_AUDIO_ANALYSIS_ENABLED=true
#DISCORD_AUDIO_ANALYSIS_CACHE_DIR=/absolute/path/to/shared/audio-cache
#DISCORD_AUDIO_FFMPEG_PATH=/absolute/path/to/ffmpeg
#DISCORD_AUDIO_FFPROBE_PATH=/absolute/path/to/ffprobe
#DISCORD_AUDIO_ANALYSIS_TIMEOUT_MS=60000
#DISCORD_AUDIO_ANALYSIS_MAX_BYTES=26214400

# Reaction suppression (issue #21) lives in DISCORD_FILTERS_FILE as the
# operator-maintained "suppressedReactionEmojis" key — reaction markers
# that must never be shown to the model (they carry classifier signaling).
# The glyphs go in the FILE, never in env/recipe values — resolved-config
# logs would reproduce them. Example file:
#   { "guildIds": ["<snowflake>"],
#     "suppressedReactionEmojis": ["<emoji>", "<custom emoji snowflake>"] }
# Matching ignores VS-16/colon differences; numeric snowflake entries also
# match custom emojis by id. The key is not adjustable via filters_update
# (the tool has no parameter for it); edit the file — it hot-reloads within
# ~3s. Unset = no protection (a startup line says so). A bad rewrite keeps
# the last-known-good set for the life of the process (status "stale"); a
# filters file that never loaded withholds ALL reactions until repaired.

# Host-injected protective baseline for reaction suppression (comma-
# separated). Applies — and seeds the filters file's key on first
# materialization — only when no operator configuration exists: a file key
# (including an explicit []) or the deprecated env below always wins,
# never unioned. "Wins" includes a PRESENT-but-empty deprecated env: that
# was the emergency filter's explicit OFF, and this baseline never
# reappears underneath it. Intended to be set by host composition from the Agent
# Framework's refusal-annotation map (Discord never authors that catalog);
# standalone deployments leave it unset and honestly report no protection.
# Process-static: read once at startup. Lost configuration never falls
# back to this baseline — it is for never-configured deployments only.
#DISCORD_SUPPRESSED_REACTIONS_BASELINE=

# DEPRECATED compatibility source: the 2026-08-03 emergency containment
# listed suppressed reaction emojis directly in env. It still works while
# no filters file carries the suppressedReactionEmojis key (same matching,
# driving the same projector), and it seeds the key when the filters file
# is first materialized. Process-static: read once at startup — changing
# it requires a restart (hot reload belongs to the filters file). Once a
# file carries the key, this env is ignored (never merged) with a warning.
# Migration: write the key (or let the seed do it), unset this, verify
# filters_get reports source "file". Retires per issue #16 once fleet
# inventory shows migrated files.
#DISCORD_SUPPRESS_REACTION_EMOJIS=

# Optional operator-created durable batching for high-traffic rooms. The
# policy document fixes the allowed channel/guild boundary and direct-address
# grace; its three ambient thresholds can be tuned through delivery_policy_set.
# Each incoming message is written to the queue before slow work, delivered to
# Chronicle separately and chronologically, and only the stable-prefix tail is
# wake-enabled. The queue file defaults beside the policy file when omitted.
#DISCORD_DELIVERY_POLICY_FILE=/absolute/path/to/delivery-policy.json
#DISCORD_DELIVERY_QUEUE_FILE=/absolute/path/to/delivery-queue.json

# Required together when any delivery-policy channel enables imageTriage.
# Originals and inference-safe renderings are content-addressed locally while
# Discord's signed URL is fresh. The prompt is sent to the Host's separately
# authorized fixed-model, no-tools image-triage service. The model name here is
# checked against the Host response; the Host recipe remains authoritative.
#DISCORD_IMAGE_ATTACHMENT_STORE_DIR=/absolute/path/to/image-attachments
#DISCORD_IMAGE_TRIAGE_PROMPT_FILE=/absolute/path/to/image-describer.md
#DISCORD_IMAGE_TRIAGE_MODEL=claude-haiku-4-5-20251001
